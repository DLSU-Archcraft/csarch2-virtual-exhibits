      <!-- Bento Box Layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full items-stretch">
        
        <!-- About the Project (Spans 2 cols) -->
        <section class="md:col-span-2 bg-[#090d16]/60 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-[#39FF14]/30 transition-colors duration-500 shadow-2xl relative overflow-hidden group reveal reveal-fade-up">
          <div class="absolute top-0 right-0 w-64 h-64 bg-[#39FF14]/10 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/4 group-hover:bg-[#39FF14]/20 transition-colors duration-700"></div>
          <div class="relative z-10 h-full flex flex-col justify-between">
            <div>
