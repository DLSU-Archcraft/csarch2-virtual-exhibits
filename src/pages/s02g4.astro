              <h3 class="font-display text-xl md:text-2xl font-bold text-white uppercase tracking-wider">Exhibit Overview</h3>
            </div>
            <p class="text-xs text-zinc-500 font-mono hidden md:block tracking-widest">DRAG TO EXPLORE &rarr;</p>
          </div>
          
