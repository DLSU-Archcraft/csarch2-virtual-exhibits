              ))}
            </div>
          </div>
        </section>

        <!-- Exhibit Overview: Decades Carousel -->
        <section class="md:col-span-3 bg-[#090d16]/60 backdrop-blur-xl rounded-3xl p-8 border border-white/10 shadow-2xl mt-4 reveal reveal-fade-up">
          <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-3">
