</style>

<script>
  const track   = document.getElementById('slide-track');
  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');

  if (track && btnPrev && btnNext) {
    const realSlides = Array.from(track.querySelectorAll('.slide'));
    const totalReal  = realSlides.length; // 3

    // Clone last → prepend (index 0), clone first → append (index 4)
    // Final order: [Clone-Slide3, Slide1, Slide2, Slide3, Clone-Slide1]
    // Next always increments index (moves track left), Prev always decrements (moves right).
    const firstClone = realSlides[0].cloneNode(true);
    const lastClone  = realSlides[totalReal - 1].cloneNode(true);
    firstClone.setAttribute('aria-hidden', 'true');
    lastClone.setAttribute('aria-hidden',  'true');
    track.appendChild(firstClone);               // index totalReal + 1 (4)
    track.insertBefore(lastClone, realSlides[0]); // index 0

    let current = 1; // start on real Slide1
    let busy    = false;

    function goTo(index, animate) {
      if (!animate) {
        track.style.transition = 'none';
        void track.offsetWidth; // force reflow so 'none' takes effect before transform changes
      } else {
        track.style.transition = 'transform 0.8s ease-in-out';
      }
      track.style.transform = `translateX(${index * -100}%)`;
      current = index;
    }

    goTo(1, false); // initialise without animation

    // After animated transition: if on a clone, snap silently to the real slide
    track.addEventListener('transitionend', () => {
      busy = false;
      if (current === 0)             goTo(totalReal, false); // clone of last → real last
      if (current === totalReal + 1) goTo(1,          false); // clone of first → real first
    });

    btnNext.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      goTo(current + 1, true); // always increments → track moves left → forward
    });

    btnPrev.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      goTo(current - 1, true); // always decrements → track moves right → backward
    });
  }
</script>
