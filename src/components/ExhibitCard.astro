---
import { Icon } from 'astro-icon/components';
const { exhibit } = Astro.props;
const { slug, section, group, title, authors, description, keywords, repo, url } =
  exhibit;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(`${base}/${slug}`, Astro.site);
const snapshotSrc = `https://api.microlink.io/?url=${encodeURIComponent(pageUrl)}&screenshot=true&meta=false&embed=screenshot.url`;
---
<article class="card" id={slug}>
  <img class="card__snapshot" src={snapshotSrc} alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('span'),{textContent:'[No image available]',style:'width:200px;height:200px;flex-shrink:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;background:#eee;color:#666;'}))"/>
  <div class="card__body">
<!--<p class="card__tag">{section} &middot; Group {group}</p>-->
    <h3 class="card__title">
      <a href=`${base}/${slug}` target="_blank">
        {title}<Icon name="ic:baseline-open-in-new" class="card__ico" />
      </a>
    </h3>
    <p class="card__authors">{authors.join(' · ')}</p>
    <p class="card__desc">{description}</p>
    <ul class="card__keywords">
      {keywords.map((keyword) => <li class="chip">{keyword}</li>)}
    </ul>
    <p class="card__foot">
      <a class="card__repo" href={repo} target="_blank" rel="noopener noreferrer">
        <Icon name="ic:baseline-code" /> Repository
      </a>
    </p>
  </div>
</article>
