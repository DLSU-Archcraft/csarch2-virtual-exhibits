---
import { Icon } from 'astro-icon/components';
const { exhibit } = Astro.props;
const { slug, section, group, title, authors, description, keywords, repo, url } = exhibit;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(`${base}/${slug}`, Astro.site);
const snapshotSrc = `https://api.microlink.io/?url=${encodeURIComponent(pageUrl)}&screenshot=true&meta=false&embed=screenshot.url`;
const exhibitHref = `${base}/${slug}`;
---
<article 
  class="card" 
  id={slug}
  data-slug={slug}
  data-title={title}
  data-authors={JSON.stringify(authors)}
  data-description={description}
  data-keywords={JSON.stringify(keywords)}
  data-href={exhibitHref}
  data-snapshot={snapshotSrc}
  data-repo={repo}
  tabindex="0"
  role="button"
  aria-haspopup="dialog"
>
  <img 
    class="card__snapshot" 
    src={snapshotSrc} 
    alt={`Snapshot of ${title}`} 
    loading="lazy" 
    onerror="this.replaceWith(Object.assign(document.createElement('span'),{textContent:'[No image available]',style:'width:200px;height:200px;flex-shrink:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;background:#eee;color:#666;'}))"
  />
  <div class="card__body">
    <h3 class="card__title">
      <span class="card__title-text">{title}</span>
    </h3>
    <p class="card__authors">{authors.join(' · ')}</p>
    <p class="card__desc">{description}</p>
    <ul class="card__keywords">
      {keywords.map((keyword: string) => <li class="chip">{keyword}</li>)}
    </ul>
    <div class="card__foot">
      <span class="card__open-hint">Click card for details & comments</span>
      <a class="card__repo" href={repo} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">
        <Icon name="ic:baseline-code" /> Repository
      </a>
    </div>
  </div>
</article>