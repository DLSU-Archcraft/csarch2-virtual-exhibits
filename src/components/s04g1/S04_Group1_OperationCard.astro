---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  mnemonic: string;
  opcode: string;
  symbol: string;
  summary: string;
  scope: 'core' | 'advanced';
  diagram?: ImageMetadata;
}

const { id, title, mnemonic, opcode, symbol, summary, scope, diagram } = Astro.props;
---

<a class="card" href={`/csarch2-virtual-exhibits/s04g1/operations/${id}/`}>
  <div class="card__head">
    <span class="card__mnemonic">{mnemonic}</span>
    <span class="card__scope">{scope === 'advanced' ? 'Advanced' : 'Core'}</span>
    <span class="card__opcode mono-value">{opcode}</span>
  </div>

  {
    diagram && (
      <div class="card__diagram">
        <Image src={diagram} alt={`Gate-level diagram for ${title}`} width={320} height={180} />
      </div>
    )
  }

  <h3 class="card__title">
    {title} <span class="card__symbol">{symbol}</span>
  </h3>
  <p class="card__summary">{summary}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--trace-dim);
    transform: translateY(-2px);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
  }
  .card__mnemonic {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--trace);
  }
  .card__scope {
    margin-left: auto;
    color: var(--paper-dim);
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card__opcode {
    font-size: 0.78rem;
    color: var(--paper-dim);
  }
  .card__diagram {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg);
  }
  .card__diagram :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .card__title {
    font-size: 1.05rem;
    margin: 0;
  }
  .card__symbol {
    color: var(--paper-dim);
    font-weight: 400;
  }
  .card__summary {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--paper-dim);
    margin: 0;
  }
</style>
